---
import Base from "@/layouts/Base.astro";
import Posts from "@/layouts/Posts.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import { humanize } from "@/lib/utils/textConverter";
import { MIN_POSTS_TO_INDEX } from "@/lib/utils/thinTaxonomies.mjs";

export async function getStaticPaths() {
  const tags = await getTaxonomy("posts", "tags");

  return tags.map((tag) => {
    return {
      params: { tag },
    };
  });
}

const { tag } = Astro.params;

const posts = await getSinglePage("posts");
const filterByTags = taxonomyFilter(posts, "tags", tag);
const sortedPosts = sortByDate(filterByTags);

const title = humanize(tag || "");

// A tag with one post behind it is a near-duplicate of that post, and Search Console
// bears that out — these come back "Crawled/Discovered - currently not indexed". Keep
// them navigable but out of the index, so signals go to the posts instead. The sitemap
// filter in astro.config.mjs drops the same URLs.
const isThin = sortedPosts.length < MIN_POSTS_TO_INDEX;
---

<Base
  title={title || "Tag"}
  meta_title={`${title} — Posts | Ciara's Classroom`}
  description={`Posts from Ciara's Classroom tagged ${title}: ideas for inclusive, diverse and multicultural primary classrooms.`}
  noindex={isThin}
>
  <div class="section">
    <div class="container">
      <p class="text-center text-2xl mb-4">Showing Posts From</p>
      <h1 class="h2 mb-16 text-center text-primary">{title}</h1>
      <Posts posts={sortedPosts} fluid={false} />
    </div>
  </div>
</Base>
