---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import products from "@/lib/fixtures/tpt_products_MOST_RECENT.json";
import * as cheerio from "cheerio";

export async function getStaticPaths() {
  const CURRENCY_VARIANTS = {
    US: { suffix: "US", currency: "USD", symbol: "$" },
    CA: { suffix: "CA", currency: "CAD", symbol: "CA$" },
    IE: { suffix: "IE", currency: "EUR", symbol: "€" },
    UK: { suffix: "UK", currency: "GBP", symbol: "£" },
    AU: { suffix: "AU", currency: "AUD", symbol: "A$" },
    NZ: { suffix: "NZ", currency: "NZD", symbol: "NZ$" },
    SG: { suffix: "SG", currency: "SGD", symbol: "S$" },
    HK: { suffix: "HK", currency: "HKD", symbol: "HK$" },
    ZA: { suffix: "ZA", currency: "ZAR", symbol: "R" },
    IN: { suffix: "IN", currency: "INR", symbol: "₹" },
    MY: { suffix: "MY", currency: "MYR", symbol: "RM" },
    PH: { suffix: "PH", currency: "PHP", symbol: "₱" },
    AE: { suffix: "AE", currency: "AED", symbol: "د.إ" },
  } as const;

  const extractFirstParagraph = (htmlString) => {
    const $ = cheerio.load(htmlString);
    return $("p").first().prop("outerHTML");
  };

  const formatReviews = (evaluations) => {
    if (!evaluations || evaluations.length === 0) return null;

    return evaluations.map((evaluation) => ({
      id: evaluation.id,
      author: evaluation.user.displayName,
      date: new Date(evaluation.updatedAt).toLocaleDateString(),
      datePublished: new Date(evaluation.updatedAt).toISOString().slice(0, 10),
      rating:
        evaluation.signals.overall_qual_how_satisfied_stars === "extremely"
          ? 5
          : evaluation.signals.overall_qual_how_satisfied_stars === "very"
            ? 4
            : evaluation.signals.overall_qual_how_satisfied_stars === "moderately"
              ? 3
              : evaluation.signals.overall_qual_how_satisfied_stars === "slightly"
                ? 2
                : 1,
      content: evaluation.signals.buyer_experience,
      helpfulCount: evaluation.helpfulCount,
    }));
  };

  const createProductVariant = (product, variantKey: keyof typeof CURRENCY_VARIANTS | "" = "") => {
    const variant = variantKey ? CURRENCY_VARIANTS[variantKey] : { suffix: "", currency: "USD", symbol: "$" };
    return {
      props: {
        product: {
          ...product,
          description: extractFirstParagraph(product.description),
          id: `${product.slug.split("-").pop()}${variant.suffix ? `-${variant.suffix}` : ""}`,
          currency: variant.currency,
          currencySymbol: variant.symbol,
          // Keep the numeric `reviews` count (from ...product) for the rating
          // summary and AggregateRating; detailed review bodies live separately.
          reviewList: formatReviews(product.evaluations),
        },
      },
      params: {
        id: `${product.slug}${variant.suffix ? `-${variant.suffix}` : ""}`,
      },
    };
  };

  return products.flatMap((product) => [
    createProductVariant(product),
    ...Object.keys(CURRENCY_VARIANTS).map((key) =>
      createProductVariant(product, key as keyof typeof CURRENCY_VARIANTS),
    ),
  ]);
}

// Product structured data lives solely in the JSON-LD below. An earlier microdata copy
// of the same Product was removed: Google merges microdata and JSON-LD into one entity,
// and the two had drifted apart (365 vs 14 return days, and a ReturnByMail method that
// does not exist for instant downloads), which risks invalidating the whole rich result.
const MAX_SCHEMA_REVIEWS = 20;

const { product } = Astro.props;

// Currency variants (-US, -IE, -AU, …) are the landing pages named by `link` in the
// Google Merchant feed, one per country. They used to canonicalise to the suffix-less
// base page to stop ~14 near-duplicates splitting ranking signals, but that pointed a
// EUR/GBP/AUD offer at a page rendering USD: Google crawls the feed link, compares its
// structured data against the feed, and flags "Mismatched value (price)".
//
// So each variant is now self-canonical (its offer URL, price and currency all agree)
// and carries `noindex, follow` instead. Shopping and free listings are driven by the
// feed rather than the web index, so the offers are unaffected, while organic search
// still sees only the one base page. The sitemap filter in astro.config.mjs already
// omits the variants.
// Trailing slash matches what GitHub Pages actually serves; the slashless form 301s.
const isCurrencyVariant = Astro.params.id !== product.slug;
const canonicalURL = new URL(`/product/${Astro.params.id}/`, Astro.site);

const price = product.currencies[product.currency];

const getCountryInfo = (id) => {
  const suffix = id.split("-").pop();
  switch (suffix) {
    case "US":
      return { name: "United States", identifier: "US", currency: "USD" };
    case "CA":
      return { name: "Canada", identifier: "CA", currency: "CAD" };
    case "IE":
      return { name: "Ireland", identifier: "IE", currency: "EUR" };
    case "UK":
      // URL suffix is "UK", but schema.org country identifiers are ISO 3166-1 alpha-2,
      // where the United Kingdom is "GB". The Merchant feed already sends GB, so
      // emitting "UK" here made the landing page contradict the feed.
      return { name: "United Kingdom", identifier: "GB", currency: "GBP" };
    case "AU":
      return { name: "Australia", identifier: "AU", currency: "AUD" };
    case "NZ":
      return { name: "New Zealand", identifier: "NZ", currency: "NZD" };
    case "SG":
      return { name: "Singapore", identifier: "SG", currency: "SGD" };
    case "HK":
      return { name: "Hong Kong", identifier: "HK", currency: "HKD" };
    case "ZA":
      return { name: "South Africa", identifier: "ZA", currency: "ZAR" };
    case "IN":
      return { name: "India", identifier: "IN", currency: "INR" };
    case "MY":
      return { name: "Malaysia", identifier: "MY", currency: "MYR" };
    case "PH":
      return { name: "Philippines", identifier: "PH", currency: "PHP" };
    case "AE":
      return { name: "United Arab Emirates", identifier: "AE", currency: "AED" };
    default:
      return { name: "United States", identifier: "US", currency: "USD" }; // Default to US if no match
  }
};

const countryInfo = getCountryInfo(product.id);

const ProductSchema = JSON.stringify({
  "@context": "https://schema.org/",
  "@type": "Product",
  name: product.title,
  image: product.images,
  description: product.descriptionSnippet,
  sku: product.id,
  mpn: product.id,
  brand: {
    "@type": "Brand",
    name: "Ciara's Classroom",
  },
  areaServed: {
    "@type": "Country",
    name: countryInfo.name,
    identifier: countryInfo.identifier,
  },
  aggregateRating:
    product.reviews > 0
      ? {
          "@type": "AggregateRating",
          ratingValue: product.rating,
          reviewCount: product.reviews,
          bestRating: 5,
          worstRating: 1,
        }
      : undefined,
  // Individual reviews (not just the aggregate) are what let Google render review
  // snippets under the result. Capped so the JSON-LD block stays a sane size.
  review: product.reviewList?.length
    ? product.reviewList.slice(0, MAX_SCHEMA_REVIEWS).map((review) => ({
        "@type": "Review",
        author: { "@type": "Person", name: review.author },
        datePublished: review.datePublished,
        reviewRating: {
          "@type": "Rating",
          ratingValue: review.rating,
          bestRating: 5,
          worstRating: 1,
        },
        reviewBody: review.content,
      }))
    : undefined,
  offers: {
    "@type": "Offer",
    url: canonicalURL.toString(),
    priceCurrency: countryInfo.currency,
    price: product.currencies[countryInfo.currency],
    priceValidUntil: `${new Date().getFullYear() + 1}-12-31`,
    itemCondition: "https://schema.org/NewCondition",
    availability: "https://schema.org/InStock",
    areaServed: {
      "@type": "Country",
      name: countryInfo.name,
      identifier: countryInfo.identifier,
    },
    hasMerchantReturnPolicy: {
      "@type": "MerchantReturnPolicy",
      applicableCountry: countryInfo.identifier,
      returnPolicyCategory: "https://schema.org/MerchantReturnFiniteReturnWindow",
      merchantReturnDays: 14,
      // No `returnMethod`: every resource is an instant download, so there is nothing to
      // post back. Claiming ReturnByMail would describe a physical process that does not
      // exist. `returnFees` stays FreeReturn — a return never costs the buyer anything.
      returnFees: "https://schema.org/FreeReturn",
      returnShippingFeesAmount: {
        "@type": "MonetaryAmount",
        value: 0,
        currency: countryInfo.currency,
      },
      returnPolicyLink: "https://ciarasclassroom.com/refund-policy/",
      additionalProperty: [
        {
          "@type": "PropertyValue",
          name: "RefundPolicy",
          value:
            "All sales are final and nonrefundable for downloaded or accessed digital resources. " +
            "Refunds are considered in specific scenarios within 14 days of purchase. Resources are " +
            "instant digital downloads, so nothing needs to be returned or posted back.",
        },
        {
          "@type": "PropertyValue",
          name: "RefundScenarios",
          value:
            "Compromised resource file, misrepresentation, technical limitations, duplicate purchase, or unaccessed file status.",
        },
      ],
    },
    shippingDetails: {
      "@type": "OfferShippingDetails",
      shippingRate: {
        "@type": "MonetaryAmount",
        value: "0",
        currency: countryInfo.currency,
      },
      shippingDestination: {
        "@type": "DefinedRegion",
        addressCountry: countryInfo.identifier,
      },
      deliveryTime: {
        "@type": "ShippingDeliveryTime",
        handlingTime: {
          "@type": "QuantitativeValue",
          minValue: "0",
          maxValue: "0",
          unitCode: "DAY",
        },
        transitTime: {
          "@type": "QuantitativeValue",
          minValue: "0",
          maxValue: "0",
          unitCode: "DAY",
        },
      },
    },
  },
});

const formatPrice = (price: number | string): string => {
  if (typeof price === "string") {
    return price === "0.00" ? "Free" : `${product.currencySymbol}${price}`;
  }
  return price === 0 ? "Free" : `${product.currencySymbol}${price.toFixed(2)}`;
};
---

<Base
  title={product.title}
  description={product.descriptionSnippet}
  image={product.images[0]}
  external_image={true}
  canonical={canonicalURL.toString()}
  noindex={isCurrencyVariant}
>
  <script type="application/ld+json" set:html={ProductSchema} />

  <div class="container mx-auto px-4 py-8">
    <article class="bg-white shadow-lg rounded-lg overflow-hidden">
      <div class="md:flex">
        <div class="md:w-1/2 p-4">
          <div class="w-full h-0 pb-[100%] relative mb-4">
            <Image
              src={product.images[0]}
              alt={product.title}
              width={400}
              height={400}
              class="absolute inset-0 w-full h-full object-contain"
              id="mainImage"
            />
          </div>
          <div class="grid grid-cols-4 gap-2">
            {
              product.images.map((image, index) => (
                <div class="aspect-w-1 aspect-h-1 cursor-pointer">
                  <Image
                    src={image}
                    alt={`${product.title} - Image ${index + 1}`}
                    width={100}
                    height={100}
                    class={`rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300 ease-in-out object-cover w-full h-full thumbnail ${index === 0 ? "border-2 border-primary" : ""}`}
                    data-src={image}
                  />
                </div>
              ))
            }
          </div>
        </div>
        <div class="p-8 md:w-1/2">
          <header>
            <div class="uppercase tracking-wide text-sm text-primary font-semibold">
              {product.categories.join(", ")}
            </div>
            <h1 class="mt-1 text-3xl font-bold text-gray-900">
              {product.title}
            </h1>
          </header>
          <div set:html={product.description} class="mt-2 text-gray-600" />

          <div class="mt-4">
            <span class="text-gray-500">Price:</span>
            <span class="ml-2 text-2xl font-bold text-gray-900">
              {formatPrice(price)}
            </span>
          </div>

          {
            product.reviews > 0 && (
              <div class="mt-4 flex items-center">
                <span class="text-gray-500">Rating:</span>
                <span class="ml-2 text-yellow-500">
                  {"★".repeat(Math.round(product.rating))}
                  {"☆".repeat(5 - Math.round(product.rating))}
                </span>
                <span class="ml-2 text-gray-500">
                  ({product.rating}/5 based on {product.reviews} {product.reviews === 1 ? "review" : "reviews"})
                </span>
              </div>
            )
          }

          <a
            href={product.link.replace("ciarasclassroom.com", "teacherspayteachers.com").replace(/\/$/, "")}
            class="mt-4 btn rounded-lg border border-light bg-transparent text-center transition hover:border-primary hover:bg-primary hover:text-white px-4 py-2 inline-block"
          >
            {price === 0 ? "Get for Free" : "Buy Now"}
          </a>

        </div>
      </div>
    </article>

    {
      product.reviewList && product.reviewList.length > 0 && (
        <div class="mt-4 bg-white shadow-lg rounded-lg overflow-hidden">
          <div class="md:flex">
            <div class="md p-4">
              <h2 class="text-2xl font-bold mb-4">Customer Reviews</h2>
              {product.reviewList.map((review) => (
                <div
                  id={`review-${review.id}-${product.currency}`}
                  class="mb-4 pb-4 border-b border-gray-300 last:border-b-0"
                >
                  <div class="flex items-center mb-2">
                    <span class="text-yellow-500 mr-2">
                      {"★".repeat(review.rating)}
                      {"☆".repeat(5 - review.rating)}
                    </span>
                    <span class="font-semibold">{review.author}</span>
                    <span class="text-gray-500 ml-2">{review.date}</span>
                  </div>
                  <p class="text-gray-700 review-content">{review.content}</p>
                  {review.helpfulCount > 0 && (
                    <div class="mt-2 text-sm text-gray-500">
                      {review.helpfulCount} {review.helpfulCount === 1 ? "person" : "people"} found this helpful
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      )
    }
  </div>
</Base>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const mainImage = document.getElementById("mainImage") as HTMLImageElement;
    const thumbnails = document.querySelectorAll(".thumbnail");

    thumbnails.forEach((thumb) => {
      thumb.addEventListener("click", function () {
        const src = this.getAttribute("data-src");
        if (src && mainImage) {
          mainImage.src = src;
          thumbnails.forEach((t) => t.classList.remove("border-2", "border-primary"));
          this.classList.add("border-2", "border-primary");
        }
      });
    });
  });
</script>
